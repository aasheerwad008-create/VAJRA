# ─── VAJRA Environment Configuration ───────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=vajra
POSTGRES_PASSWORD=vajra_secret
POSTGRES_DB=vajra
DATABASE_URL=postgresql://vajra:vajra_secret@postgres:5432/vajra

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Voice AI Service ────────────────────────────────────────────────────────
VOICE_AI_HOST=voice-ai
VOICE_AI_PORT=8001

# ── Adversarial Engine ──────────────────────────────────────────────────────
ADVERSARIAL_HOST=adversarial-engine
ADVERSARIAL_PORT=8002

# ── ZK Proof System ─────────────────────────────────────────────────────────
ZK_PROOF_HOST=zk-proof-system
ZK_PROOF_PORT=8003

# ── Backend ─────────────────────────────────────────────────────────────────
BACKEND_HOST=backend
BACKEND_PORT=8080
JWT_SECRET=change_me_in_production_32_char_min
API_KEY=vajra_api_key_change_me

# ── Blockchain ──────────────────────────────────────────────────────────────
